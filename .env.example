# Database is embedded SQLite — no setup needed. Optionally override the file location:
# DB_PATH=C:\somewhere\job-tracker.db

PORT=3001
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Sessions
SESSION_SECRET=replace_with_a_long_random_string

# Classification runs locally via Ollama (qwen2.5:7b) — no API key required.
