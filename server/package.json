{
	"name": "job-tracker-server",
	"version": "1.0.2",
	"type": "commonjs",
	"scripts": {
		"start": "tsx index.ts",
		"dev": "tsx watch index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start:compiled": "node dist/index.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"better-sqlite3": "^12.11.1",
		"cors": "^2.8.0",
		"dotenv": "^16.0.0",
		"express": "^4.18.0",
		"express-session": "^1.17.0",
		"googleapis": "^173.0.0",
		"ollama": "^0.6.3"
	},
	"//overrides": "gaxios (via googleapis-common) pulls an old rimraf->glob->minimatch chain whose brace-expansion has a DoS advisory. npm cannot dedupe it because the copy is nested, so pin the fixed line here. Drop this once gaxios ships a rimraf that no longer needs it.",
	"overrides": {
		"brace-expansion": "^5.0.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vitest": "^4.1.8"
	}
}
